---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/og-default.png';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;

const siteHref = Astro.site?.href;

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteHref}#website`,
			url: siteHref,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			inLanguage: 'en-US',
		},
		{
			'@type': 'ProfilePage',
			'@id': `${siteHref}#profile`,
			url: siteHref,
			name: SITE_TITLE,
			mainEntity: { '@id': `${siteHref}#person` },
		},
		{
			'@type': 'Person',
			'@id': `${siteHref}#person`,
			name: 'Dylan Herthoge',
			givenName: 'Dylan',
			familyName: 'Herthoge',
			url: siteHref,
			jobTitle: 'Full-Stack Developer II',
			worksFor: {
				'@type': 'Organization',
				name: 'Tire Rack',
				url: 'https://www.tirerack.com',
			},
			description: SITE_DESCRIPTION,
			knowsAbout: [
				'Software engineering',
				'Conversational AI',
				'E-commerce',
				'Full-stack web development',
				'TypeScript',
				'Astro',
			],
			homeLocation: {
				'@type': 'Place',
				address: {
					'@type': 'PostalAddress',
					addressLocality: 'Mishawaka',
					addressRegion: 'IN',
					addressCountry: 'US',
				},
			},
			sameAs: [
				'https://github.com/dherthoge',
				'https://www.linkedin.com/in/dylanherthoge',
			],
		},
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<!-- theme-color sets the iOS Safari / Android Chrome chrome color so the
     status bar and bottom safe-area match the page background. Updated
     dynamically in the pre-paint script + the toggle handler. -->
<meta name="theme-color" id="theme-color-meta" content="#14110d" />

<!-- Theme: set data-theme BEFORE first paint to avoid a flash of wrong theme.
     Default to dark for new visitors; respect localStorage if they've toggled. -->
<script is:inline>
	(function () {
		try {
			var stored = localStorage.getItem('theme');
			var theme = stored || 'dark';
			document.documentElement.setAttribute('data-theme', theme);
			var meta = document.getElementById('theme-color-meta');
			if (meta) meta.setAttribute('content', theme === 'dark' ? '#14110d' : '#faf7f2');
		} catch (e) {
			document.documentElement.setAttribute('data-theme', 'dark');
		}
	})();
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=8" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Fonts: preconnect first so the handshake happens in parallel with HTML parsing -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter+Tight:wght@400;500;600&display=swap" />

<meta name="generator" content={Astro.generator} />
<meta name="author" content="Dylan Herthoge" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- Structured data: Person + WebSite + ProfilePage as one @graph -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
