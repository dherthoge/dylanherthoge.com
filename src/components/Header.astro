---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			<a class="icon" href="https://github.com/dherthoge" target="_blank" rel="noopener" aria-label="GitHub">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.8 1.18 1.82 1.18 3.08 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/>
				</svg>
			</a>
			<a class="icon" href="https://www.linkedin.com/in/dylanherthoge" target="_blank" rel="noopener" aria-label="LinkedIn">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/>
				</svg>
			</a>
			<a class="icon" href="mailto:dylanherthoge@outlook.com" aria-label="Email">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="2.5" y="4.5" width="19" height="15" rx="1.5"/>
					<path d="m3 6 9 7 9-7"/>
				</svg>
			</a>
			<button class="icon theme-toggle" type="button" aria-label="Toggle theme">
				<svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
				</svg>
				<svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"/>
					<path d="M12 2v2"/>
					<path d="M12 20v2"/>
					<path d="m4.93 4.93 1.41 1.41"/>
					<path d="m17.66 17.66 1.41 1.41"/>
					<path d="M2 12h2"/>
					<path d="M20 12h2"/>
					<path d="m4.93 19.07 1.41-1.41"/>
					<path d="m17.66 6.34 1.41-1.41"/>
				</svg>
			</button>
		</div>

		<script is:inline>
			document.querySelector('.theme-toggle')?.addEventListener('click', () => {
				const current = document.documentElement.getAttribute('data-theme');
				const next = current === 'dark' ? 'light' : 'dark';
				document.documentElement.setAttribute('data-theme', next);
				try { localStorage.setItem('theme', next); } catch (e) {}
				const meta = document.getElementById('theme-color-meta');
				if (meta) meta.setAttribute('content', next === 'dark' ? '#14110d' : '#faf7f2');
			});
		</script>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--rule);
		background: var(--cream);
	}
	nav {
		max-width: 680px;
		margin: 0 auto;
		padding: 1.25em 1em;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
	}
	.brand {
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink);
		background: none;
		padding: 0;
	}
	@media (hover: hover) {
		.brand:hover { color: var(--rust); }
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1em;
	}
	.links a {
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--ink-soft);
		background: none;
		padding: 0;
	}
	.links a.icon,
	.links button.icon {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
		padding: 0;
		background: none;
		border: 0;
		cursor: pointer;
		line-height: 0;
		font: inherit;
	}
	/* theme-toggle icon swap rules live in global.css so the
	   [data-theme] selector on <html> (outside this component's
	   Astro scope) reliably matches. */
	@media (hover: hover) {
		.links a:hover { color: var(--rust); }
		.links a.icon:hover,
		.links button.icon:hover { color: var(--rust); }
	}
	.links a.icon svg { display: block; }
	.dot {
		color: var(--ink-faint);
		font-size: 0.85rem;
	}
	@media (max-width: 480px) {
		.links a[href="/blog"], .links a[href="/about"] { display: none; }
		.dot { display: none; }
	}
</style>
