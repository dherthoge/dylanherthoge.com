---
const today = new Date();
---

<footer>
	<div class="inner">
		<span class="eyebrow">© {today.getFullYear()} Dylan Herthoge</span>
		<span class="eyebrow muted">South Bend, IN</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--rule);
		padding: 2em 1em;
		margin-top: 4em;
	}
	.inner {
		max-width: 680px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
	}
	.muted { color: var(--ink-faint); }
</style>
